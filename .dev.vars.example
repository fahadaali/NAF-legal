# انسخ هذا الملف إلى .dev.vars للتطوير المحلي (لا تُودِعه في Git)
# للإنتاج استخدم: wrangler secret put ANTHROPIC_API_KEY  و  wrangler secret put JWT_SECRET

# مفتاح Claude API من https://console.anthropic.com
ANTHROPIC_API_KEY = "sk-ant-..."

# سرّ توقيع الجلسات (JWT) — سلسلة عشوائية طويلة
JWT_SECRET = "استبدلني-بسلسلة-عشوائية-طويلة-وآمنة"

# سرّ هذه المنصة لدى خدمة الهوية naf-id — للتطوير المحلي وحده.
# مصدره: naf-id ← لوحة الإدارة ← المنصات ← NAF-legal. يعرضه المركز مرة
# واحدة؛ فإن فُقد فدوّره من اللوحة نفسها.
# وللإنتاج: wrangler secret put AUTH_CLIENT_SECRET  — لا يُكتب في أي ملف.
AUTH_CLIENT_SECRET = "استبدلني-بسرّ-المنصة-من-لوحة-naf-id"
